# 이 파일을 복사해 .env로 저장하고 본인 codebeamer 계정 정보를 채우세요.
# .env는 절대 git에 커밋하지 마세요 (.gitignore에 이미 등록되어 있음).

CB_USERNAME=your.codebeamer.id
CB_PASSWORD=your-codebeamer-password
CB_PROJECT_NAME=GM_9BQX_HL_LDM
CB_BASE_URL=https://codebeamer.slworld.com/cb/rest
CB_BASE_URL_V3=https://codebeamer.slworld.com/cb/api/v3
CB_TRACKER_CIL=[SUP.8]Configuration Item List
CB_TRACKER_NCL=[SUP.9]Non-Conformance List
