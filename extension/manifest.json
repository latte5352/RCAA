{
  "manifest_version": 3,
  "name": "SUP.8 형상감사 자동화 (서버리스)",
  "version": "0.1.0",
  "description": "codebeamer 주기적 형상감사 자동화 - 백엔드 서버 없이 확장에서 codebeamer에 직접 접속",
  "action": {},
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://codebeamer.slworld.com/*"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
